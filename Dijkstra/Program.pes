// Алгоритм Дейкстры: кратчайшие пути из вершины в графе с неотрицательными весами.
// Матрица смежности как Массив<Массив<Число>>.

конст ЧислоВершин = 6
конст Бесконечность = 1000000
конст Старт = 0

метод ПустаяСтрока(): Массив<Число>
    пер конец: Число = ЧислоВершин - 1
    пер row = [Бесконечность]
    для i = 1 по конец
        row.Добавить(Бесконечность)
    ;
    возврат row
;

метод ПустаяМатрица(): Массив<Массив<Число>>
    пер конец: Число = ЧислоВершин - 1
    пер m = [ПустаяСтрока()]
    для i = 1 по конец
        m.Добавить(ПустаяСтрока())
    ;
    для i = 0 по конец
        m[i][i] = 0
    ;
    возврат m
;

метод ДобавитьРебро(m: Массив<Массив<Число>>, u: Число, v: Число, вес: Число)
    m[u][v] = вес
    m[v][u] = вес
;

// Классический учебный граф (неориентированный).
метод ПостроитьГраф(): Массив<Массив<Число>>
    пер m = ПустаяМатрица()
    ДобавитьРебро(m, 0, 1, 7)
    ДобавитьРебро(m, 0, 2, 9)
    ДобавитьРебро(m, 0, 5, 14)
    ДобавитьРебро(m, 1, 2, 10)
    ДобавитьРебро(m, 1, 3, 15)
    ДобавитьРебро(m, 2, 3, 11)
    ДобавитьРебро(m, 2, 5, 2)
    ДобавитьРебро(m, 3, 4, 6)
    ДобавитьРебро(m, 4, 5, 9)
    возврат m
;

метод СоздатьРасстояния(старт: Число): Массив<Число>
    пер конец: Число = ЧислоВершин - 1
    пер d = [Бесконечность]
    для i = 1 по конец
        d.Добавить(Бесконечность)
    ;
    d[старт] = 0
    возврат d
;

метод СоздатьПосещения(): Массив<Булево>
    пер конец: Число = ЧислоВершин - 1
    пер посещено = [Ложь]
    для i = 1 по конец
        посещено.Добавить(Ложь)
    ;
    возврат посещено
;

метод БлижайшаяНепосещенная(d: Массив<Число>, посещено: Массив<Булево>): Число
    пер лучшая: Число = -1
    пер лучшийВес: Число = Бесконечность
    пер конец: Число = ЧислоВершин - 1
    для u = 0 по конец
        если не посещено[u] и d[u] < лучшийВес
            лучшийВес = d[u]
            лучшая = u
        ;
    ;
    возврат лучшая
;

метод Дейкстра(m: Массив<Массив<Число>>, старт: Число): Массив<Число>
    пер d = СоздатьРасстояния(старт)
    пер посещено = СоздатьПосещения()
    пер конец: Число = ЧислоВершин - 1
    для итерация = 1 по ЧислоВершин
        пер u: Число = БлижайшаяНепосещенная(d, посещено)
        если u < 0
            прервать
        ;
        посещено[u] = Истина
        для v = 0 по конец
            пер вес: Число = m[u][v]
            если не посещено[v] и вес < Бесконечность и d[u] + вес < d[v]
                d[v] = d[u] + вес
            ;
        ;
    ;
    возврат d
;

метод ФорматРасстояния(значение: Число): Строка
    если значение >= Бесконечность
        возврат "∞"
    ;
    возврат Преобразование.ВСтроку(значение)
;

метод ПечатьРасстояний(d: Массив<Число>, старт: Число)
    Консоль.ЗаписатьСтроку("Кратчайшие пути из вершины $старт:")
    пер конец: Число = ЧислоВершин - 1
    для v = 0 по конец
        Консоль.ЗаписатьСтроку("  $старт → $v = ${ФорматРасстояния(d[v])}")
    ;
;

пер граф = ПостроитьГраф()
пер расстояния = Дейкстра(граф, Старт)
ПечатьРасстояний(расстояния, Старт)
