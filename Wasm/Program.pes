// Пес в браузере через .NET WebAssembly (browser-wasm).
// Вывод Консоль.* попадает в DevTools → Console (F12).
//
// Требуется: dotnet workload install wasm-tools
// Запуск:    dotnet run --project Wasm/Wasm.psproj

метод Фибоначчи(n: Число): Число
    если n <= 1
        возврат n
    ;
    пер a: Число = 0
    пер b: Число = 1
    пер последний: Число = n - 1
    для i = 1 по последний
        пер next = a + b
        a = b
        b = next
    ;
    возврат b
;

метод Факториал(n: Число): Число
    пер result: Число = 1
    для i = 2 по n
        result = result * i
    ;
    возврат result
;

метод Главный(): ничто
    Консоль.ЗаписатьСтроку("=== Пес × WebAssembly ===")
    Консоль.ЗаписатьСтроку("Среда: .NET browser-wasm")
    Консоль.ЗаписатьСтроку("")

    конст n = 12
    Консоль.ЗаписатьСтроку("Фибоначчи($n) = ${Фибоначчи(n)}")
    Консоль.ЗаписатьСтроку("Факториал(8) = ${Факториал(8)}")

    пер числа = [3, 1, 4, 1, 5, 9]
    пер сумма: Число = 0
    для x из числа
        сумма = сумма + x
    ;
    Консоль.ЗаписатьСтроку("Сумма [3,1,4,1,5,9] = $сумма")
    Консоль.ЗаписатьСтроку("")
    Консоль.ЗаписатьСтроку("Готово.")
;

Главный()
