// O-38: алиасы user-типов, BCL и пространств имен через .pesmap
импорт Система::ВводВывод

@Алиас("Сервис")
класс Service
    @Алиас("Выполнить")
    метод Run(x: Число): Число
        возврат x + 1
    ;

    @Алиас("Выполнить")
    метод Run(x: Число, y: Число): Число
        возврат x + y
    ;

    статический метод Проверить(ч: Число): Булево
        возврат ч > 10
    ;
;

пер s = новый Сервис()
Консоль.ЗаписатьСтроку(s.Выполнить(40))
Консоль.ЗаписатьСтроку(s.Выполнить(20, 22))

пер ok = Файл.Существует("no-such-file.pes")
Консоль.ЗаписатьСтроку(ok)

пер проверка = Сервис.Проверить(40)
Консоль.ЗаписатьСтроку(проверка)
