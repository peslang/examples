// Исключения: попытка/поймать/вконце, выбросить; поймать e: A|B (O-03).
// prespecs: exceptions


исключение ОшибкаЗначения
    обз пер Значение: Число
;

исключение ОшибкаДиапазона
    обз пер Минимум: Число
    обз пер Максимум: Число
;

метод ПроверитьНеотрицательное(x: Число): ничто
    если x < 0
        выбросить новый ОшибкаЗначения("отрицательный аргумент", x)
    ;
;

метод ПроверитьДиапазон(x: Число, мин: Число, макс: Число): ничто
    если x < мин или x > макс
        выбросить новый ОшибкаДиапазона(
            Описание = "вне диапазона",
            Минимум = мин,
            Максимум = макс)
    ;
;

метод БезопасноУдвоить(x: Число): Строка
    пер журнал = ""
    попытка
        журнал = журнал + "проверка "
        ПроверитьНеотрицательное(x)
        пер результат = x * 2
        журнал = журнал + "→ ${результат}"
        возврат журнал
    поймать e: ОшибкаЗначения
        возврат "поймано: ${e.Описание}, значение=${e.Значение}"
    вконце
        журнал = журнал + " [вконце]"
    ;
;

Консоль.ЗаписатьСтроку("=== успех ===")
Консоль.ЗаписатьСтроку(БезопасноУдвоить(9))

Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== перехват ===")
Консоль.ЗаписатьСтроку(БезопасноУдвоить(-1))

// Переменная e имеет составной тип ОшибкаЗначения|ОшибкаДиапазона.
// A|B и B|A эквивалентны; общие члены (Описание) доступны напрямую.
Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== поймать A|B: значение ===")
попытка
    ПроверитьНеотрицательное(-3)
поймать e: ОшибкаЗначения|ОшибкаДиапазона
    Консоль.ЗаписатьСтроку("объединение: ${e.Описание}")
поймать e: Исключение
    Консоль.ЗаписатьСтроку("прочее: ${e.Описание}")
;

Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== поймать B|A: диапазон ===")
попытка
    ПроверитьДиапазон(150, 0, 100)
поймать e: ОшибкаДиапазона|ОшибкаЗначения
    Консоль.ЗаписатьСтроку("объединение: ${e.Описание}")
поймать e: Исключение
    Консоль.ЗаписатьСтроку("прочее: ${e.Описание}")
;

Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== не из объединения → следующий поймать ===")
попытка
    выбросить новый Исключение("чужое")
поймать e: ОшибкаЗначения|ОшибкаДиапазона
    Консоль.ЗаписатьСтроку("объединение: ${e.Описание}")
поймать e: Исключение
    Консоль.ЗаписатьСтроку("прочее: ${e.Описание}")
;

// Переменная с составным типом (storage object, типизация на compile-time).
Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== пер x: Строка|Число ===")
пер значение: Строка|Число = "текст"
Консоль.ЗаписатьСтроку(значение)
значение = 100
Консоль.ЗаписатьСтроку(значение)

// Сужение как/это
Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== как / это ===")
пер смесь: Строка|Число = "hello"
если смесь это Строка
    пер s = смесь как Строка
    Консоль.ЗаписатьСтроку("строка: ${s}")
;

смесь = 42
если смесь это Число
    пер n = смесь как Число
    Консоль.ЗаписатьСтроку("число: ${n}")
;

// Массив с union-элементами
Консоль.ЗаписатьСтроку("")
Консоль.ЗаписатьСтроку("=== Массив<Строка|Число> ===")
пер список: Массив<Строка|Число> = ["a", 1]
Консоль.ЗаписатьСтроку("элементов: ${список.Количество}")

