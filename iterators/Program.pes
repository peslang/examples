// Обходимое / Обходчик + породить (O-46).
// prespecs: iterable-type

метод Диапазон(от: Число, до: Число): Обходимое<Число>
    пер i = от
    пока i <= до
        породить i
        i = i + 1
    ;
;

класс Квадраты : Обходимое<Число>
    пер _до: Число

    конструктор(до: Число)
        _до = до
    ;

    метод ПолучитьОбходчик(): Обходчик<Число>
        пер n = 1
        пока n <= _до
            породить n * n
            n = n + 1
        ;
    ;
;

пер сумма = 0
для x из Диапазон(1, 5)
    сумма = сумма + x
;
Консоль.ЗаписатьСтроку(сумма)

пер кв = 0
для q из новый Квадраты(3)
    кв = кв + q
;
Консоль.ЗаписатьСтроку(кв)
